# ========================================================
# JobPilot AI - Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit .env to version control!
# ========================================================

# --- Application Core ---
PROJECT_NAME="JobPilot AI"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string

# --- Job Search & Operational Defaults ---
TIMEZONE=Asia/Karachi
GLOBAL_DAILY_APPLICATION_LIMIT=30
DEFAULT_MIN_MATCH_SCORE=75
JOB_FRESHNESS_HOURS=72
DISCOVERY_CRON_SCHEDULE="0 */6 * * *"
EMERGENCY_PAUSE=False
DRY_RUN_MODE=True

# --- Supabase Database & API ---
# PostgreSQL connection string for SQLAlchemy (Transaction Pooler: port 6543 or Session: port 5432)
# e.g., postgresql+psycopg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase REST / Storage API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_STORAGE_BUCKET=regional-resumes

# --- AI & LLM Provider ---
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_or_groq_api_key
OPENAI_MODEL=gpt-4o-mini

# --- Gmail OAuth 2.0 Integration ---
GMAIL_CLIENT_ID=your_gmail_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback

# --- Frontend Client Environment (apps/web/.env) ---
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key
